# All keys are optional. The free path (OpenStreetMap + site crawl + local verify) needs none.
# Copy to .env (leadgen init does this) and fill in only what you have. Never commit .env.

# Google Places sourcing (paid)
GOOGLE_PLACES_API_KEY=
# Apollo companies + contacts (paid plan)
APOLLO_API_KEY=
# Hunter contacts, email pattern, verification
HUNTER_API_KEY=
# Instantly push + verification (see docs/CONNECTORS.md for scopes)
INSTANTLY_API_KEY=
# GoHighLevel push: private integration token and sub-account id
GHL_API_KEY=
GHL_LOCATION_ID=
